# Public site URL used for canonical links, sitemap and OG tags (no trailing slash).
# NEXT_PUBLIC_SITE_URL=https://agent-fails.vercel.app

# Newsletter ("翻车 of the week"). A PUBLIC form action URL, no API keys.
# The signup form POSTs a field named "email" plus a hidden "tag" of "en" or "zh".
# Next.js inlines this at build time, so a change needs a new deploy.
# Leave it unset and the form is a local stub that stores nothing.
#
# Production and Preview on the agent-fails Vercel project already use the public
# Buttondown embed for https://buttondown.com/agentfails ("AgentFails Weekly").
# An invalid address is rejected by Buttondown; a valid one is stored on that list.
# NEXT_PUBLIC_NEWSLETTER_FORM_ACTION=https://buttondown.com/api/emails/embed-subscribe/agentfails
