# Public site URL used for canonical links, sitemap and OG tags (no trailing slash).
# NEXT_PUBLIC_SITE_URL=https://agent-fails.vercel.app

# Newsletter ("翻车 of the week"). A PUBLIC form action URL, no API keys.
# The form POSTs a field named "email". Leave unset to show a harmless stub that stores nothing.
# Buttondown example: https://buttondown.com/api/emails/embed-subscribe/<your-newsletter>
# NEXT_PUBLIC_NEWSLETTER_FORM_ACTION=
